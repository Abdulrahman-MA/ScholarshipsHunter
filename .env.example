# Scholarships Hunter - Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# API Rotation Pools: Comma-separated list of keys for automatic rate-limit failover
# (You can provide 1 key or multiple keys to cycle through)
GROQ_API_KEYS=gsk_your_groq_api_key_1,gsk_your_groq_api_key_2

GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Optional: Local Ollama Configuration (Set to True to evaluate locally without external APIs)
USE_OLLAMA=False
OLLAMA_MODEL=llama3.1
